# ===== Server =====
NODE_ENV=development
PORT=5000
# Comma-separated frontend URLs allowed by CORS (local + production)
CLIENT_URL=http://localhost:5173

# Production example (Render):
# CLIENT_URL=https://jala-coral.vercel.app,http://localhost:5173

# ===== Database (MySQL) =====
# Option A — local / Docker:
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=artisan_db

# Option B — cloud MySQL (Render + Aiven / PlanetScale / Railway):
# Use ONE of these approaches:
#
# B1) Connection string (URL-encode special characters in the password):
# DATABASE_URL=mysql://avnadmin:PASSWORD@mysql-xxxx.aivencloud.com:10446/defaultdb
# DB_SSL=true
#
# B2) Individual vars (easier if password has @ or # characters):
# DB_HOST=mysql-xxxx.aivencloud.com
# DB_PORT=10446
# DB_USER=avnadmin
# DB_PASSWORD=your_password_here
# DB_NAME=defaultdb
# DB_SSL=true

# ===== Auth =====
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d

# ===== Cloudinary (portfolio/profile image storage) =====
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ===== Email (Nodemailer SMTP) =====
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Artisan Koforidua <no-reply@artisan.gh>"

# ===== SMS / OTP (Hubtel or Twilio) =====
# Provider can be: hubtel | twilio | console (console just logs the OTP for dev)
SMS_PROVIDER=console
HUBTEL_CLIENT_ID=
HUBTEL_CLIENT_SECRET=
HUBTEL_SENDER_ID=Artisan
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# ===== Payments (Paystack) =====
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# ===== Google Maps (used by frontend; key surfaced via /api/config) =====
GOOGLE_MAPS_API_KEY=
