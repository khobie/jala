# ===== Server =====
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# ===== Database (MySQL) =====
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=artisan_db

# ===== Auth =====
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d

# ===== Cloudinary (portfolio/profile image storage) =====
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ===== Email (Nodemailer SMTP) =====
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Artisan Koforidua <no-reply@artisan.gh>"

# ===== SMS / OTP (Hubtel or Twilio) =====
# Provider can be: hubtel | twilio | console (console just logs the OTP for dev)
SMS_PROVIDER=console
HUBTEL_CLIENT_ID=
HUBTEL_CLIENT_SECRET=
HUBTEL_SENDER_ID=Artisan
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# ===== Payments (Paystack) =====
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# ===== Google Maps (used by frontend; key surfaced via /api/config) =====
GOOGLE_MAPS_API_KEY=
